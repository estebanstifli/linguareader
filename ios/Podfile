# Dependencias de la app iOS que no llegan por el framework compartido. ML Kit solo se distribuye por CocoaPods.
# Solo para la app de iPhone: en CI, el job de dispositivo hace `xcodegen generate` y `pod install` y compila el
# .xcworkspace. El job del simulador compila el .xcodeproj sin pods, porque los binarios de ML Kit no traen rebanada
# arm64 de simulador (CocoaPods excluye arm64 y obligaría a un simulador x86_64 bajo Rosetta); `MlKitTranslator.swift`
# se compila solo si el módulo existe (`#if canImport(MLKitTranslate)`) y el test de traducción se omite.
platform :ios, '17.0'
use_frameworks!

target 'LinguaReader' do
  # Traducción en el dispositivo, mismos modelos (~30 MB por idioma) que la app Android.
  pod 'GoogleMLKit/Translate', '8.0.0'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '17.0'
      config.build_settings['COMPILER_INDEX_STORE_ENABLE'] = 'NO'
    end
  end
end
