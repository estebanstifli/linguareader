    "Anything still downloading continues in the background: you can start now.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que siga descargándose continúa en segundo plano: ya puedes empezar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui se télécharge encore continue en arrière-plan : vous pouvez commencer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was noch heruntergeladen wird, läuft im Hintergrund weiter: Du kannst jetzt loslegen."
