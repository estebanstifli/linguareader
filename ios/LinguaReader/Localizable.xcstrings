        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aussi : ouvrez le fichier dans Fichiers, Mail, WhatsApp ou Telegram et choisissez « Ouvrir dans » › LingoAudioBook."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
