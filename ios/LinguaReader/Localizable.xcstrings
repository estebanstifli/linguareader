    "Translating needs the model of the book's language and of your language. Words and sentences are translated on the phone, without sending the text anywhere.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para traducir hacen falta el modelo del idioma del libro y el de tu idioma. Las palabras y frases se traducen en el teléfono, sin enviar el texto a ningún sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduction nécessite le modèle de la langue du livre et celui de votre langue. Les mots et les phrases sont traduits sur le téléphone, sans envoyer le texte nulle part."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Übersetzen werden das Modell der Buchsprache und das deiner Sprache benötigt. Wörter und Sätze werden auf dem Telefon übersetzt, ohne den Text irgendwohin zu senden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per tradurre servono il modello della lingua del libro e quello della tua lingua. Parole e frasi vengono tradotte sul telefono, senza inviare il testo da nessuna parte."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para traduzir são necessários o modelo do idioma do livro e o do seu idioma. Palavras e frases são traduzidas no telefone, sem enviar o texto a lugar nenhum."
          }
        }
      }
    },
