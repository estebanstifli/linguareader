    "Translate the whole book now so no sentence has to wait while you read. It runs in the background and can be stopped and resumed.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduce todo el libro ahora para que ninguna frase tenga que esperar mientras lees. Va en segundo plano y se puede parar y continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduisez tout le livre maintenant pour qu'aucune phrase n'attende pendant la lecture. Cela tourne en arrière-plan et peut être arrêté et repris."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übersetze jetzt das ganze Buch, damit beim Lesen kein Satz warten muss. Läuft im Hintergrund und lässt sich anhalten und fortsetzen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduci tutto il libro ora così nessuna frase dovrà aspettare mentre leggi. Va in background e si può fermare e riprendere."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduza o livro inteiro agora para nenhuma frase precisar esperar enquanto você lê. Roda em segundo plano e pode ser parado e retomado."
          }
        }
      }
