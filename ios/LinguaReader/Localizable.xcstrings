    "“%@” will leave the library. You can restore it from the library's Trash.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» saldrá de la biblioteca. Puedes restaurarlo desde la Papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » quittera la bibliothèque. Vous pourrez le restaurer depuis la Corbeille."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ verlässt die Bibliothek. Du kannst es aus dem Papierkorb wiederherstellen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» uscirà dalla biblioteca. Potrai ripristinarlo dal Cestino."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” sairá da biblioteca. Você pode restaurá-lo na Lixeira."
          }
        }
      }
    },
