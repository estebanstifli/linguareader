    "When you continue, the library starts downloading in the background; you can keep using the app.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al continuar, la biblioteca empieza a descargarse en segundo plano; puedes seguir usando la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous continuez, la bibliothèque commence à se télécharger en arrière-plan ; vous pouvez continuer à utiliser l'app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du fortfährst, wird die Bibliothek im Hintergrund heruntergeladen; du kannst die App weiter benutzen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando continui, la biblioteca inizia a scaricarsi in background; puoi continuare a usare l'app."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao continuar, a biblioteca começa a ser baixada em segundo plano; você pode continuar usando o app."
          }
        }
      }
    },
