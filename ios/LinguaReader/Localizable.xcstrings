    "Sentences already synthesized are kept so they play instantly next time. The oldest ones are removed when the limit is reached.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las frases ya sintetizadas se conservan para sonar al instante la próxima vez. Al llegar al límite se borran las más antiguas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les phrases déjà synthétisées sont conservées pour être lues instantanément la prochaine fois. Les plus anciennes sont supprimées quand la limite est atteinte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereits erzeugte Sätze werden behalten, damit sie beim nächsten Mal sofort abspielen. Beim Erreichen des Limits werden die ältesten entfernt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le frasi già sintetizzate vengono conservate per essere riprodotte all'istante la prossima volta. Raggiunto il limite, si eliminano le più vecchie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As frases já sintetizadas são mantidas para tocar na hora na próxima vez. Ao chegar ao limite, as mais antigas são removidas."
          }
        }
      }
    },
