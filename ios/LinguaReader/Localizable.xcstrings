    "Learn languages by reading and listening: graded readers, a voice that highlights each word, and translation on tap, all offline.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprende idiomas leyendo y escuchando: lecturas graduadas, una voz que resalta cada palabra y traducción al tocar, todo sin conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apprenez des langues en lisant et en écoutant : lectures graduées, une voix qui surligne chaque mot et traduction d'un toucher, le tout hors ligne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprachen lernen durch Lesen und Hören: Lektüren nach Niveau, eine Stimme, die jedes Wort hervorhebt, und Übersetzung per Fingertipp, alles offline."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impara le lingue leggendo e ascoltando: letture graduate, una voce che evidenzia ogni parola e traduzione con un tocco, tutto offline."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprenda idiomas lendo e ouvindo: leituras graduadas, uma voz que destaca cada palavra e tradução ao tocar, tudo off-line."
          }
        }
      }
    },
