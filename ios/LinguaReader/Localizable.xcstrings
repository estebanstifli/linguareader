    "Your native language: words and sentences are translated into it. Translation happens on the phone with Google ML Kit and works offline once each language's model is downloaded (≈40 MB).": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu idioma: las palabras y frases se traducen a él. La traducción se hace en el móvil con Google ML Kit y funciona sin conexión una vez descargado el modelo de cada idioma (≈40 MB)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre langue : les mots et les phrases sont traduits dans celle-ci. La traduction se fait sur le téléphone avec Google ML Kit et fonctionne hors ligne une fois le modèle de chaque langue téléchargé (≈40 Mo)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Muttersprache: Wörter und Sätze werden in sie übersetzt. Die Übersetzung läuft auf dem Telefon mit Google ML Kit und funktioniert offline, sobald das Modell jeder Sprache geladen ist (≈40 MB)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua lingua: parole e frasi vengono tradotte in essa. La traduzione avviene sul telefono con Google ML Kit e funziona offline una volta scaricato il modello di ogni lingua (≈40 MB)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu idioma: palavras e frases são traduzidas para ele. A tradução é feita no celular com o Google ML Kit e funciona offline depois de baixar o modelo de cada idioma (≈40 MB)."
          }
        }
      }
    },
