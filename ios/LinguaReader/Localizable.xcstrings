    "In the background and on the device; it takes time depending on the size (%lld paragraphs). Afterwards you can read without waiting or a connection.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En segundo plano y en el dispositivo; tarda según el tamaño (%lld párrafos). Después podrás leer sin esperas ni conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En arrière-plan et sur l'appareil ; cela prend du temps selon la taille (%lld paragraphes). Ensuite vous lirez sans attente ni connexion."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Hintergrund und auf dem Gerät; je nach Größe dauert es (%lld Absätze). Danach liest du ohne Wartezeit und ohne Verbindung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In background e sul dispositivo; richiede tempo a seconda delle dimensioni (%lld paragrafi). Dopo potrai leggere senza attese né connessione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em segundo plano e no aparelho; leva tempo conforme o tamanho (%lld parágrafos). Depois você lê sem esperar nem precisar de conexão."
          }
        }
      }
    },
