    "Choose one or several. We'll download their libraries of graded readers (A1 to B2) and the translators, so you can read and listen offline.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige uno o varios. Descargaremos sus bibliotecas de lecturas graduadas (A1 a B2) y los traductores, para leer y escuchar sin conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez-en une ou plusieurs. Nous téléchargerons leurs bibliothèques de lectures graduées (A1 à B2) et les traducteurs, pour lire et écouter hors ligne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine oder mehrere. Wir laden ihre Bibliotheken mit gestuften Lektüren (A1 bis B2) und die Übersetzer herunter, damit du offline lesen und hören kannst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegline una o più. Scaricheremo le loro biblioteche di letture graduate (da A1 a B2) e i traduttori, per leggere e ascoltare offline."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um ou vários. Baixaremos suas bibliotecas de leituras graduadas (A1 a B2) e os tradutores, para ler e ouvir offline."
          }
        }
      }
    },
