    "Graded readers (A1–B2) with word-by-word audio. Each library is about 5 MB and works offline once downloaded.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecturas graduadas (A1–B2) con audio palabra por palabra. Cada biblioteca ocupa unos 5 MB y funciona sin conexión una vez descargada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lectures graduées (A1–B2) avec audio mot à mot. Chaque bibliothèque fait environ 5 Mo et fonctionne hors ligne une fois téléchargée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lektüren nach Niveau (A1–B2) mit Wort-für-Wort-Audio. Jede Bibliothek ist etwa 5 MB groß und funktioniert nach dem Download offline."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Letture graduate (A1–B2) con audio parola per parola. Ogni biblioteca occupa circa 5 MB e funziona offline una volta scaricata."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Leituras graduadas (A1–B2) com áudio palavra por palavra. Cada biblioteca tem cerca de 5 MB e funciona off-line depois de baixada."
          }
        }
      }
    },
    "Graded readers: our own adaptations of public-domain works. Your imported books stay only on your device.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecturas graduadas: adaptaciones propias de obras de dominio público. Tus libros importados se quedan solo en tu dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lectures graduées : nos propres adaptations d'œuvres du domaine public. Vos livres importés restent uniquement sur votre appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lektüren nach Niveau: eigene Bearbeitungen gemeinfreier Werke. Deine importierten Bücher bleiben nur auf deinem Gerät."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Letture graduate: nostri adattamenti di opere di pubblico dominio. I libri che importi restano solo sul tuo dispositivo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Leituras graduadas: adaptações próprias de obras em domínio público. Seus livros importados ficam somente no seu dispositivo."
          }
        }
      }
    },
