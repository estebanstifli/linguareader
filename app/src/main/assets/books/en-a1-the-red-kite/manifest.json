  "cover": { "path": "images/cover.png", "sha256": "3584c1e6f8de783572899274c52d73c04d69085e50bc53ef42455ad7884466ed", "alt": "A red and yellow kite with a blue tail flying over the sea.", "credit": "Original illustration generated by tools/generate_demo_images.py (CC0-1.0)" },
  "chapters": [
    {
      "id": "ch1",
      "title": "A Windy Day",
      "titleTranslations": { "es": "Un día de viento", "fr": "Une journée de vent" },
      "passages": [
        {
          "id": "ch1-p1",
          "image": { "path": "images/ch1-p1.png", "sha256": "5409f1a51aa5170af10df3355401550326bca8a509686dd49305d702a180e4e9", "alt": "A small white house next to the sea on a windy morning.", "credit": "Original illustration generated by tools/generate_demo_images.py (CC0-1.0)" },
          "sentences": [
            { "id": "s1", "text": "Tom is eight years old.", "translations": { "es": "Tom tiene ocho años.", "fr": "Tom a huit ans." } },
            { "id": "s2", "text": "He lives in a small house near the sea.", "translations": { "es": "Vive en una casa pequeña cerca del mar.", "fr": "Il habite dans une petite maison près de la mer." } },
            { "id": "s3", "text": "Today is Saturday, and it is very windy.", "translations": { "es": "Hoy es sábado y hace mucho viento.", "fr": "Aujourd'hui, c'est samedi, et il y a beaucoup de vent." } },
            { "id": "s4", "text": "Tom wakes up early and looks out of the window.", "translations": { "es": "Tom se despierta temprano y mira por la ventana.", "fr": "Tom se réveille tôt et regarde par la fenêtre." } },
            { "id": "s5", "text": "\"Perfect!\" he says.", "translations": { "es": "«¡Perfecto!», dice.", "fr": "« Parfait ! » dit-il." } },
            { "id": "s6", "text": "\"It's a good day for my kite.\"", "translations": { "es": "«Es un buen día para mi cometa».", "fr": "« C'est une bonne journée pour mon cerf-volant. »" } }
          ]
        },
        {
          "id": "ch1-p2",
          "sentences": [
            { "id": "s1", "text": "His kite is red and yellow.", "translations": { "es": "Su cometa es roja y amarilla.", "fr": "Son cerf-volant est rouge et jaune." } },
            { "id": "s2", "text": "It has a long blue tail.", "translations": { "es": "Tiene una cola larga y azul.", "fr": "Il a une longue queue bleue." } },
            { "id": "s3", "text": "Tom puts on his coat and his shoes.", "translations": { "es": "Tom se pone el abrigo y los zapatos.", "fr": "Tom met son manteau et ses chaussures." } },
            { "id": "s4", "text": "His sister, Anna, goes with him.", "translations": { "es": "Su hermana, Anna, va con él.", "fr": "Sa sœur, Anna, va avec lui." } },
            { "id": "s5", "text": "They walk to the beach together.", "translations": { "es": "Caminan juntos hasta la playa.", "fr": "Ils marchent ensemble jusqu'à la plage." } }
          ]
        },
        {
          "id": "ch1-p3",
          "image": { "path": "images/ch1-p3.png", "sha256": "ed18e1020565f9a3748edf5a69b8be2c4e4d8459b5e80e2cdc59660283e7c001", "alt": "Two children on a beach; a red and yellow kite flies high in the sky.", "credit": "Original illustration generated by tools/generate_demo_images.py (CC0-1.0)" },
          "sentences": [
            { "id": "s1", "text": "On the beach, the wind is strong.", "translations": { "es": "En la playa, el viento es fuerte.", "fr": "Sur la plage, le vent est fort." } },
            { "id": "s2", "text": "Tom runs, and the kite goes up into the sky.", "translations": { "es": "Tom corre y la cometa sube al cielo.", "fr": "Tom court, et le cerf-volant monte dans le ciel." } },
            { "id": "s3", "text": "\"Look, Anna! It's flying!\" he shouts.", "translations": { "es": "«¡Mira, Anna! ¡Está volando!», grita.", "fr": "« Regarde, Anna ! Il vole ! » crie-t-il." } },
            { "id": "s4", "text": "The kite goes higher and higher.", "translations": { "es": "La cometa sube cada vez más alto.", "fr": "Le cerf-volant monte de plus en plus haut." } }
          ]
        }
      ]
    },
    {
      "id": "ch2",
      "title": "The Lost Kite",
      "titleTranslations": { "es": "La cometa perdida", "fr": "Le cerf-volant perdu" },
      "passages": [
        {
          "id": "ch2-p1",
          "sentences": [
            { "id": "s1", "text": "Suddenly, the wind is very, very strong.", "translations": { "es": "De repente, el viento es muy, muy fuerte.", "fr": "Soudain, le vent est très, très fort." } },
            { "id": "s2", "text": "The string breaks!", "translations": { "es": "¡El hilo se rompe!", "fr": "La ficelle casse !" } },
            { "id": "s3", "text": "The red kite flies away over the trees.", "translations": { "es": "La cometa roja se va volando por encima de los árboles.", "fr": "Le cerf-volant rouge s'envole au-dessus des arbres." } },
            { "id": "s4", "text": "Tom is sad.", "translations": { "es": "Tom está triste.", "fr": "Tom est triste." } },
            { "id": "s5", "text": "\"My kite! I can't see it now.\"", "translations": { "es": "«¡Mi cometa! Ahora no la veo».", "fr": "« Mon cerf-volant ! Je ne le vois plus. »" } }
          ]
        },
        {
          "id": "ch2-p2",
          "image": { "path": "images/ch2-p2.png", "sha256": "8377ff06ab2563cc61edf22bb3e8bbb9593a3879df694c660b65c1dbcb5f781b", "alt": "An old man next to a bench and a lighthouse, holding a red kite.", "credit": "Original illustration generated by tools/generate_demo_images.py (CC0-1.0)" },
          "sentences": [
            { "id": "s1", "text": "Anna takes his hand.", "translations": { "es": "Anna le coge la mano.", "fr": "Anna lui prend la main." } },
            { "id": "s2", "text": "\"Don't worry. Let's look for it,\" she says.", "translations": { "es": "«No te preocupes. Vamos a buscarla», dice ella.", "fr": "« Ne t'inquiète pas. Cherchons-le », dit-elle." } },
            { "id": "s3", "text": "They look behind the trees and near the old lighthouse.", "translations": { "es": "Buscan detrás de los árboles y cerca del viejo faro.", "fr": "Ils cherchent derrière les arbres et près du vieux phare." } },
            { "id": "s4", "text": "There, an old man is standing next to a bench.", "translations": { "es": "Allí, un hombre mayor está de pie junto a un banco.", "fr": "Là, un vieil homme est debout à côté d'un banc." } },
            { "id": "s5", "text": "He has a red kite in his hands!", "translations": { "es": "¡Tiene una cometa roja en las manos!", "fr": "Il a un cerf-volant rouge dans les mains !" } }
          ]
        },
        {
          "id": "ch2-p3",
          "sentences": [
            { "id": "s1", "text": "\"Is this your kite?\" the man asks.", "translations": { "es": "«¿Es esta tu cometa?», pregunta el hombre.", "fr": "« C'est ton cerf-volant ? » demande l'homme." } },
            { "id": "s2", "text": "\"Yes! Thank you very much!\" says Tom.", "translations": { "es": "«¡Sí! ¡Muchas gracias!», dice Tom.", "fr": "« Oui ! Merci beaucoup ! » dit Tom." } },
            { "id": "s3", "text": "The man smiles.", "translations": { "es": "El hombre sonríe.", "fr": "L'homme sourit." } },
            { "id": "s4", "text": "\"I had a red kite too, when I was a boy.\"", "translations": { "es": "«Yo también tenía una cometa roja cuando era niño».", "fr": "« Moi aussi, j'avais un cerf-volant rouge quand j'étais petit. »" } },
            { "id": "s5", "text": "Tom and Anna walk home happily.", "translations": { "es": "Tom y Anna vuelven a casa contentos.", "fr": "Tom et Anna rentrent à la maison, heureux." } },
            { "id": "s6", "text": "Next Saturday, they want to fly the kite with the old man.", "translations": { "es": "El próximo sábado quieren volar la cometa con el hombre mayor.", "fr": "Samedi prochain, ils veulent faire voler le cerf-volant avec le vieil homme." } }
          ]
        }
      ]
    }
  ],
