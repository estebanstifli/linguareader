  "chapters": [
    {
      "id": "ch1",
      "title": "Une liste importante",
      "titleTranslations": { "es": "Una lista importante", "en": "An important list" },
      "passages": [
        {
          "id": "ch1-p1",
          "image": { "path": "images/ch1-p1.png", "sha256": "05c3ecb59f71e65d863f94ef3ba1e72dd918d2a93619dd84bd912692efc94e96", "alt": "Des étals colorés d'un marché de quartier, le matin.", "credit": "Illustration originale générée par tools/generate_demo_images.py (CC0-1.0)" },
          "sentences": [
            { "id": "s1", "text": "Lila habite à Lyon avec sa grand-mère.", "translations": { "es": "Lila vive en Lyon con su abuela.", "en": "Lila lives in Lyon with her grandmother." } },
            { "id": "s2", "text": "Chaque samedi matin, elles vont au marché du quartier.", "translations": { "es": "Cada sábado por la mañana van al mercado del barrio.", "en": "Every Saturday morning, they go to the local market." } },
            { "id": "s3", "text": "Aujourd'hui, sa grand-mère est fatiguée et elle reste à la maison.", "translations": { "es": "Hoy su abuela está cansada y se queda en casa.", "en": "Today her grandmother is tired and she stays at home." } },
            { "id": "s4", "text": "« Tu peux y aller toute seule ? » demande-t-elle.", "translations": { "es": "«¿Puedes ir tú sola?», pregunta ella.", "en": "\"Can you go on your own?\" she asks." } },
            { "id": "s5", "text": "Lila est contente : c'est la première fois !", "translations": { "es": "Lila está contenta: ¡es la primera vez!", "en": "Lila is happy: it's the first time!" } }
          ]
        },
        {
          "id": "ch1-p2",
          "sentences": [
            { "id": "s1", "text": "Sa grand-mère lui donne une liste et un petit porte-monnaie.", "translations": { "es": "Su abuela le da una lista y un monedero pequeño.", "en": "Her grandmother gives her a list and a small purse." } },
            { "id": "s2", "text": "Sur la liste, il y a des tomates, du fromage, du pain et des fleurs.", "translations": { "es": "En la lista hay tomates, queso, pan y flores.", "en": "On the list there are tomatoes, cheese, bread and flowers." } },
            { "id": "s3", "text": "Lila met son manteau et prend un grand panier.", "translations": { "es": "Lila se pone el abrigo y coge una cesta grande.", "en": "Lila puts on her coat and takes a big basket." } },
            { "id": "s4", "text": "Elle n'a pas peur, mais elle est un peu nerveuse.", "translations": { "es": "No tiene miedo, pero está un poco nerviosa.", "en": "She isn't afraid, but she is a little nervous." } }
          ]
        }
      ]
    },
    {
      "id": "ch2",
      "title": "Au marché",
      "titleTranslations": { "es": "En el mercado", "en": "At the market" },
      "passages": [
        {
          "id": "ch2-p1",
          "image": { "path": "images/ch2-p1.png", "sha256": "a030f6edf511eae30934d504a9e3857b5bd5da7177aaccde87a92a93d311c24f", "alt": "Des tomates rouges et des morceaux de fromage sur un étal.", "credit": "Illustration originale générée par tools/generate_demo_images.py (CC0-1.0)" },
          "sentences": [
            { "id": "s1", "text": "Au marché, il y a beaucoup de monde.", "translations": { "es": "En el mercado hay mucha gente.", "en": "At the market there are a lot of people." } },
            { "id": "s2", "text": "Les vendeurs crient leurs prix et ça sent bon le pain chaud.", "translations": { "es": "Los vendedores gritan sus precios y huele bien a pan caliente.", "en": "The sellers shout their prices and it smells of warm bread." } },
            { "id": "s3", "text": "D'abord, Lila achète un kilo de tomates bien rouges.", "translations": { "es": "Primero, Lila compra un kilo de tomates bien rojos.", "en": "First, Lila buys a kilo of very red tomatoes." } },
            { "id": "s4", "text": "Ensuite, elle s'arrête devant le stand de fromages.", "translations": { "es": "Después, se para delante del puesto de quesos.", "en": "Then she stops in front of the cheese stall." } }
          ]
        },
        {
          "id": "ch2-p2",
          "sentences": [
            { "id": "s1", "text": "« Bonjour, mademoiselle ! Qu'est-ce que je vous sers ? » demande le fromager.", "translations": { "es": "«¡Buenos días, señorita! ¿Qué le pongo?», pregunta el quesero.", "en": "\"Good morning, miss! What can I get you?\" asks the cheesemonger." } },
            { "id": "s2", "text": "Lila choisit un morceau de comté, le fromage préféré de sa grand-mère.", "translations": { "es": "Lila elige un trozo de comté, el queso favorito de su abuela.", "en": "Lila chooses a piece of Comté, her grandmother's favourite cheese." } },
            { "id": "s3", "text": "Mais quand elle veut payer, elle ne trouve plus le porte-monnaie !", "translations": { "es": "Pero cuando quiere pagar, ¡ya no encuentra el monedero!", "en": "But when she wants to pay, she can't find the purse anymore!" } },
            { "id": "s4", "text": "Elle cherche dans ses poches et dans le panier.", "translations": { "es": "Busca en sus bolsillos y en la cesta.", "en": "She looks in her pockets and in the basket." } }
          ]
        },
        {
          "id": "ch2-p3",
          "image": { "path": "images/ch2-p3.png", "sha256": "b93fa77826bb6b7743f4fdad46d2c8b6838eccd4e5fffc05ac1f615bc6b1b2a4", "alt": "Un petit bouquet de fleurs jaunes.", "credit": "Illustration originale générée par tools/generate_demo_images.py (CC0-1.0)" },
          "sentences": [
            { "id": "s1", "text": "Une dame âgée s'approche avec un sourire.", "translations": { "es": "Una señora mayor se acerca con una sonrisa.", "en": "An elderly lady comes over with a smile." } },
            { "id": "s2", "text": "« C'est à toi ? Il était par terre, près des fleurs. »", "translations": { "es": "«¿Es tuyo? Estaba en el suelo, cerca de las flores».", "en": "\"Is this yours? It was on the ground, near the flowers.\"" } },
            { "id": "s3", "text": "Lila la remercie de tout son cœur.", "translations": { "es": "Lila le da las gracias de todo corazón.", "en": "Lila thanks her with all her heart." } },
            { "id": "s4", "text": "Elle lui offre une petite fleur jaune.", "translations": { "es": "Le regala una pequeña flor amarilla.", "en": "She gives her a small yellow flower." } },
            { "id": "s5", "text": "Le soir, sa grand-mère rit beaucoup en écoutant l'histoire.", "translations": { "es": "Por la noche, su abuela se ríe mucho al escuchar la historia.", "en": "In the evening, her grandmother laughs a lot as she listens to the story." } }
          ]
        }
      ]
    }
  ],
