<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: copia en la nube y paso a otro móvil. Solo lo que el usuario no puede recuperar descargando de nuevo:
     las bases de datos con su diario WAL (progreso, marcadores, vocabulario, estanterías) y sus preferencias. Se excluyen modelos (~400 MB),
     bibliotecas, libros importados y cachés: superarían el límite de 25 MB de Auto Backup, que entonces no copia nada. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/user_preferences.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/user_preferences.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
